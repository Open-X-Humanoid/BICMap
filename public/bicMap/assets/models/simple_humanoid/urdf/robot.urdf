    <visual><origin xyz="0 0 0"/><geometry><sphere radius="0.028"/></geometry><material name="blue"/></visual>
  </link>
  <joint name="right_wrist_yaw_joint" type="revolute">
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <parent link="right_elbow_link"/><child link="right_wrist_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="37"/>
  </joint>

  <link name="right_wrist_roll_link">
    <inertial><origin xyz="0 0 -0.05"/><mass value="0.25"/>
